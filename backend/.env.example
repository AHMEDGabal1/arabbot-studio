# Database (Supabase Postgres)
DATABASE_URL=postgresql+asyncpg://postgres:password@db.<project-ref>.supabase.co:6543/postgres

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Redis
REDIS_URL=redis://localhost:6379/0

# AI
LLM_PROVIDER=tokenrouter
TOKENROUTER_API_KEY=your_tokenrouter_api_key
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_MODEL=moonshotai/kimi-k3-free
GOOGLE_API_KEY=your_gemini_api_key
GEMINI_MODEL_FAST=gemini-2.0-flash-exp
GEMINI_MODEL_FULL=gemini-2.5-pro

# Meta / WhatsApp
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# App
SECRET_KEY=your_jwt_secret_32chars_min
ENVIRONMENT=development
BASE_URL=http://localhost:8000
